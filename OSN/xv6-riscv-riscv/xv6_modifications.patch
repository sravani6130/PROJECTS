@@ -0,0 +1,43 @@
+// fcfstest: shows the order in which CPU-bound children run.
+//
+// Run with one CPU to see the policy clearly:
+//   make clean; make qemu CPUS=1 SCHEDULER=FCFS     -> children run one after another
+//   make clean; make qemu CPUS=1                    -> round robin: children interleave
+
+#include "kernel/types.h"
+#include "user/user.h"
+
+#define NCHILD 3
+
+static void
+spin(void)
+{
+  volatile unsigned long x = 0;
+  for (unsigned long i = 0; i < 300000000UL; i++)
+    x += i;
+}
+
+int
+main(void)
+{
+  for (int i = 0; i < NCHILD; i++) {
+    int pid = fork();
+    if (pid < 0) {
+      fprintf(2, "fcfstest: fork failed\n");
+      exit(1);
+    }
+    if (pid == 0) {
+      int start = uptime();
+      printf("child %d (pid %d) started at tick %d\n", i, getpid(), start);
+      spin();
+      int end = uptime();
+      printf("child %d (pid %d) finished at tick %d (ran %d ticks)\n", i,
+             getpid(), end, end - start);
+      exit(0);
+    }
+  }
+  for (int i = 0; i < NCHILD; i++)
+    wait(0);
+  printf("fcfstest: all children done\n");
+  exit(0);
+}
diff --git a/user/lazytest.c b/user/lazytest.c
new file mode 100644
index 0000000..986c496
--- /dev/null
+++ b/user/lazytest.c
@@ -0,0 +1,127 @@
+// ############## LLM Generated Code Begins ##############
+// lazytest: demand paging basics and memstat().
+//   - sbrk() maps nothing; the first access zero-fills a page (ALLOC)
+//   - reads leave a page clean, writes make it dirty
+//   - invalid accesses kill the process (run in children)
+#include "kernel/types.h"
+#include "kernel/memstat.h"
+#include "user/user.h"
+
+#define PG 4096
+
+static struct proc_mem_stat st;
+static char *statename[] = {"UNMAPPED", "RESIDENT", "SWAPPED"};
+
+static void
+show(char *when)
+{
+  if (memstat(&st) < 0) {
+    printf("lazytest: memstat failed\n");
+    exit(1);
+  }
+  printf("-- %s: pid=%d total=%d resident=%d swapped=%d next_seq=%d\n", when,
+         st.pid, st.num_pages_total, st.num_resident_pages,
+         st.num_swapped_pages, st.next_fifo_seq);
+  int n = st.num_pages_total < MAX_PAGES_INFO ? st.num_pages_total
+                                              : MAX_PAGES_INFO;
+  for (int i = 0; i < n; i++) {
+    struct page_stat *ps = &st.pages[i];
+    if (ps->state == UNMAPPED)
+      continue;
+    printf("   va=0x%x %s dirty=%d seq=%d slot=%d\n", ps->va,
+           statename[ps->state], ps->is_dirty, ps->seq, ps->swap_slot);
+  }
+}
+
+// Find a page's entry in the last memstat() result.
+static struct page_stat *
+page(char *va)
+{
+  for (int i = 0; i < MAX_PAGES_INFO; i++)
+    if (st.pages[i].va == (uint)(uint64)va)
+      return &st.pages[i];
+  return 0;
+}
+
+static int fails = 0;
+static void
+check(int ok, char *what)
+{
+  printf("%s: %s\n", ok ? "PASS" : "FAIL", what);
+  if (!ok)
+    fails++;
+}
+
+// Run f in a child; it must be killed (exit status -1).
+static void
+mustdie(void (*f)(void), char *what)
+{
+  int pid = fork();
+  if (pid == 0) {
+    f();
+    exit(0); // not reached if the kernel kills us
+  }
+  int status = 0;
+  wait(&status);
+  check(status == -1, what);
+}
+
+static void
+read_past_sz(void)
+{
+  volatile char *bad = sbrk(0) + 8 * PG;
+  printf("%d\n", *bad);
+}
+
+static void
+write_text(void)
+{
+  *(volatile char *)(uint64)show = 0;
+}
+
+static void
+exec_heap(void)
+{
+  char *h = sbrk(PG);
+  h[0] = 0;
+  ((void (*)(void))h)();
+}
+
+int
+main(void)
+{
+  show("start");
+
+  char *p = sbrk(3 * PG);
+  show("after sbrk(3 pages)");
+  check(memstat(&st) == 0 && page(p)->state == UNMAPPED,
+        "sbrk does not allocate");
+
+  p[0] = 'x'; // write fault -> ALLOC, dirty
+  volatile char c = p[PG]; // read fault -> ALLOC, clean
+  (void)c;
+  memstat(&st);
+  check(page(p)->state == RESIDENT && page(p)->is_dirty == 1,
+        "write fault: resident and dirty");
+  check(page(p + PG)->state == RESIDENT && page(p + PG)->is_dirty == 0 &&
+          p[PG] == 0,
+        "read fault: resident, clean, zero-filled");
+  check(page(p + 2 * PG)->state == UNMAPPED, "untouched page stays unmapped");
+  check(page(p + PG)->seq > page(p)->seq, "FIFO seq increases");
+
+  p[PG] = 'y'; // first write to a clean page
+  memstat(&st);
+  check(page(p + PG)->is_dirty == 1, "first write marks page dirty");
+  show("after touching 2 of 3 heap pages");
+
+  mustdie(read_past_sz, "read beyond sz kills the process");
+  mustdie(write_text, "write to text kills the process");
+  mustdie(exec_heap, "executing the heap kills the process");
+
+  if (fails == 0)
+    printf("lazytest: OK\n");
+  else
+    printf("lazytest: %d FAILED\n", fails);
+  exit(fails != 0);
+}
+// ############## LLM Generated Code Ends ################
diff --git a/user/mlfqtest.c b/user/mlfqtest.c
new file mode 100644
index 0000000..986a6b6
--- /dev/null
+++ b/user/mlfqtest.c
@@ -0,0 +1,49 @@
+// mlfqtest: shows MLFQ queue movement.
+//
+//   make clean; make qemu CPUS=1 SCHEDULER=MLFQ MLFQLOG=1
+//   $ mlfqtest
+//
+// Two CPU-bound children sink Q0 -> Q1 -> Q2 -> Q3 and then take turns in
+// Q3 (round robin, 16-tick slices) until the 48-tick boost lifts them back to
+// Q0. One I/O-bound child sleeps most of the time, never uses a full slice,
+// stays in Q0 and preempts the CPU-bound ones whenever it wakes.
+
+#include "kernel/types.h"
+#include "user/user.h"
+
+static void
+spin(void)
+{
+  volatile unsigned long x = 0;
+  for (unsigned long i = 0; i < 4000000000UL; i++)
+    x += i;
+}
+
+int
+main(void)
+{
+  int cpu1 = fork();
+  if (cpu1 == 0) {
+    spin();
+    exit(0);
+  }
+  int cpu2 = fork();
+  if (cpu2 == 0) {
+    spin();
+    exit(0);
+  }
+  int io = fork();
+  if (io == 0) {
+    for (int i = 0; i < 6; i++)
+      sleep(20); // I/O-bound: blocks long before its 1-tick slice ends
+    exit(0);
+  }
+  printf("mlfqtest: CPU-bound pids %d %d, I/O-bound pid %d\n", cpu1, cpu2, io);
+
+  int wtime, rtime;
+  for (int i = 0; i < 3; i++) {
+    int pid = waitx(0, &wtime, &rtime);
+    printf("mlfqtest: pid %d done, rtime %d, wtime %d\n", pid, rtime, wtime);
+  }
+  exit(0);
+}
diff --git a/user/readcount.c b/user/readcount.c
new file mode 100644
index 0000000..d417d93
--- /dev/null
+++ b/user/readcount.c
@@ -0,0 +1,59 @@
+// readcount: test for the getreadcount() system call (Part A.2).
+//
+// Usage: readcount [file]      (default file: README)
+//
+// 1. Prints the current system-wide read byte count.
+// 2. Reads 100 bytes from the file.
+// 3. Prints the count again and checks it increased by the bytes read.
+
+#include "kernel/types.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+#define NBYTES 100
+
+int
+main(int argc, char *argv[])
+{
+  char *file = (argc > 1) ? argv[1] : "README";
+  char buf[NBYTES];
+
+  uint before = getreadcount();
+  printf("Initial read count: %u\n", before);
+
+  int fd = open(file, O_RDONLY);
+  if (fd < 0) {
+    fprintf(2, "readcount: cannot open %s\n", file);
+    exit(1);
+  }
+
+  // read() may return fewer bytes than asked, so loop until 100 bytes or EOF.
+  int total = 0;
+  while (total < NBYTES) {
+    int n = read(fd, buf + total, NBYTES - total);
+    if (n < 0) {
+      fprintf(2, "readcount: read error on %s\n", file);
+      close(fd);
+      exit(1);
+    }
+    if (n == 0)
+      break; // EOF: file is shorter than 100 bytes
+    total += n;
+  }
+  close(fd);
+  printf("Read %d bytes from %s\n", total, file);
+
+  uint after = getreadcount();
+  printf("Read count after read: %u\n", after);
+
+  // Unsigned subtraction gives the right answer even if the counter wrapped.
+  uint diff = after - before;
+  printf("Increase: %u bytes\n", diff);
+
+  if (diff == (uint)total)
+    printf("OK: read count increased by %d as expected\n", total);
+  else
+    printf("MISMATCH: expected increase of %d, got %u\n", total, diff);
+
+  exit(0);
+}
diff --git a/user/schedulertest.c b/user/schedulertest.c
new file mode 100644
index 0000000..13c7d63
--- /dev/null
+++ b/user/schedulertest.c
@@ -0,0 +1,46 @@
+// schedulertest: standard workload for comparing schedulers.
+//
+// Forks NFORK children: the first IO of them are I/O-bound (they just
+// sleep), the rest are CPU-bound (busy loop). The parent reaps each one
+// with waitx() and prints the average running time and waiting time.
+//
+// Run on one CPU:  make clean; make qemu CPUS=1 SCHEDULER=<RR|FCFS|CFS>
+
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/fcntl.h"
+
+#define NFORK 10
+#define IO 5
+
+int
+main()
+{
+  int n, pid;
+  int wtime, rtime;
+  int twtime = 0, trtime = 0;
+  for (n = 0; n < NFORK; n++) {
+    pid = fork();
+    if (pid < 0)
+      break;
+    if (pid == 0) {
+      if (n < IO) {
+        sleep(200); // IO bound processes
+      } else {
+        for (volatile int i = 0; i < 1000000000; i++) {
+        } // CPU bound process
+      }
+      // printf("Process %d finished\n", n);
+      exit(0);
+    }
+  }
+  for (; n > 0; n--) {
+    if (waitx(0, &wtime, &rtime) >= 0) {
+      trtime += rtime;
+      twtime += wtime;
+    }
+  }
+  printf("Average rtime %d,  wait time %d\n", trtime / NFORK, twtime / NFORK);
+  exit(0);
+}
diff --git a/user/swaptest.c b/user/swaptest.c
new file mode 100644
index 0000000..d67199d
--- /dev/null
+++ b/user/swaptest.c
@@ -0,0 +1,73 @@
+// ############## LLM Generated Code Begins ##############
+// swaptest [npages] [nprocs]
+// Each of nprocs processes sbrk()s npages pages, writes a pattern to every
+// page, then reads all of them back and checks the pattern. When the
+// pages do not fit in memory this exercises FIFO replacement, SWAPOUT
+// and SWAPIN, with each process evicting only its own pages.
+// Build with a small memory to see replacement quickly:
+//   make clean; make qemu PHYSMEM=4 CPUS=1
+//   $ swaptest 600 1      (fits in swap: all pages verify)
+//   $ swaptest 600 2      (two processes, each with its own swap file)
+//   $ swaptest 2000 1     (more than memory + 1024 swap slots: swap-exhausted)
+#include "kernel/types.h"
+#include "kernel/memstat.h"
+#include "user/user.h"
+
+#define PG 4096
+
+static struct proc_mem_stat st;
+
+static int
+run(int npages)
+{
+  int pid = getpid();
+  char *a = sbrk(npages * PG);
+  if (a == SBRK_ERROR) {
+    printf("swaptest: sbrk failed\n");
+    return 1;
+  }
+  for (int i = 0; i < npages; i++)
+    *(int *)(a + i * PG + 64) = i * 31 + pid;
+
+  memstat(&st);
+  printf("swaptest pid %d: wrote %d pages, resident=%d swapped=%d\n", pid,
+         npages, st.num_resident_pages, st.num_swapped_pages);
+
+  int bad = 0;
+  for (int i = 0; i < npages; i++)
+    if (*(int *)(a + i * PG + 64) != i * 31 + pid)
+      bad++;
+  memstat(&st);
+  printf("swaptest pid %d: read back %d pages, %d wrong, resident=%d "
+         "swapped=%d\n",
+         pid, npages, bad, st.num_resident_pages, st.num_swapped_pages);
+  return bad != 0;
+}
+
+int
+main(int argc, char *argv[])
+{
+  int npages = argc > 1 ? atoi(argv[1]) : 600;
+  int nprocs = argc > 2 ? atoi(argv[2]) : 1;
+
+  if (nprocs <= 1) {
+    int r = run(npages);
+    printf("swaptest: %s\n", r ? "FAILED" : "OK");
+    exit(r);
+  }
+  for (int i = 0; i < nprocs; i++) {
+    if (fork() == 0)
+      exit(run(npages));
+  }
+  int failed = 0;
+  for (int i = 0; i < nprocs; i++) {
+    int status;
+    int pid = wait(&status);
+    printf("swaptest: child %d exited with %d\n", pid, status);
+    if (status != 0)
+      failed++;
+  }
+  printf("swaptest: %s\n", failed ? "FAILED" : "OK");
+  exit(failed != 0);
+}
+// ############## LLM Generated Code Ends ################
