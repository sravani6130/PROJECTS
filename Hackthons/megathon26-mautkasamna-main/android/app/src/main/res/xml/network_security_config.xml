<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only. The NGO API URL is fixed at build
     time (GULLAK_API_URL) and must be https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
