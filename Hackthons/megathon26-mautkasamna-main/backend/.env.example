# Copy to backend/.env and adjust. Never commit the real .env.
# development | production. Production refuses demo seed data and
# requires an explicit CORS origin list.
GULLAK_ENV=development

# Where the SQLite database lives (created on first start).
GULLAK_DB_PATH=./data/gullak.db

# PostgreSQL instead of SQLite (deployments). Leave empty for SQLite.
DATABASE_URL=

# Bind address and port for `python -m app` (if GULLAK_PORT is unset, PORT is
# used, as set by Render). 127.0.0.1 is reachable from the
# Android emulator as 10.0.2.2 and from a USB phone through `adb reverse`.
GULLAK_HOST=127.0.0.1
GULLAK_PORT=8787

# Comma-separated origins allowed to call the dashboard API from a browser.
GULLAK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest accepted request body in bytes (progress reports are ~2 KB).
GULLAK_MAX_BODY_BYTES=16384

# Enrolment-code checks and registrations allowed per client IP per minute.
GULLAK_ENROL_RATE_PER_MINUTE=30

# Dashboard sign-in session lifetime.
GULLAK_SESSION_TTL_MINUTES=480

# A student counts as "active" if they played within this many days.
GULLAK_ACTIVE_DAYS=7

# Accepted progress snapshots older than this are purged from history
# (the latest snapshot per student is always kept).
GULLAK_HISTORY_RETENTION_DAYS=180

# Seed the three fictional demo NGOs, their codes and demo dashboard logins
# (public passwords) on start-up. Development only.
GULLAK_SEED_DEMO=true

# Seed only the fictional NGOs, centres and codes (no logins). For a public
# demo deployment, together with the passwords below.
GULLAK_SEED_ORGS=false

# Dashboard passwords for the demo NGOs on a public deployment (min 12
# characters; never commit real values). Unset = no login for that NGO.
GULLAK_PASSWORD_GREEN=
GULLAK_PASSWORD_UDAAN=
GULLAK_PASSWORD_YFC=

# Behind a reverse proxy (Render/Cloudflare): rate-limit by the forwarded
# client address instead of the proxy's.
GULLAK_TRUST_PROXY=false
