  "components": {
    "schemas": {
      "ChapterProgress": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7"
            ],
            "title": "Id"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed"
          },
          "best_stars": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Best Stars"
          },
          "plays": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Plays"
          },
          "first_completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Completed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "completed",
          "best_stars",
          "plays"
        ],
        "title": "ChapterProgress"
      },
      "CodeCheck": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 40,
            "minLength": 3,
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "CodeCheck"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Indicators": {
        "properties": {
          "c1_surprise_cost": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "own_money",
                  "advance"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "C1 Surprise Cost"
          },
          "c2_goal": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "kit",
                  "course",
                  "laptop"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "C2 Goal"
          },
          "c2_weeks_saved": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 4.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "C2 Weeks Saved"
          },
          "c3_pending_payment": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "verified",
                  "paid_twice",
                  "paid_cash"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "C3 Pending Payment"
          },
          "c4_scams_handled_safely": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 4.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "C4 Scams Handled Safely"
          },
          "c4_scams_followed": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 4.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "C4 Scams Followed"
          },
          "c4_hints_used": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "C4 Hints Used"
          },
          "c5_payment_method": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "debit",
                  "cash",
                  "credit",
                  "waited"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "C5 Payment Method"
          },
          "c5_credit_repayment": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "full",
                  "more_than_minimum",
                  "minimum"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "C5 Credit Repayment"
          },
          "c6_fixed_deposit": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "C6 Fixed Deposit"
          },
          "c6_emergency_source": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "savings",
                  "broke_deposit",
                  "borrowed_family"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "C6 Emergency Source"
          },
          "c7_claimed_excluded_cost": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "C7 Claimed Excluded Cost"
          },
          "c7_policy_choice": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "keep",
                  "addon",
                  "drop"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "C7 Policy Choice"
          },
          "c7_used_emergency_fund": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "C7 Used Emergency Fund"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Indicators",
        "description": "Outcomes of decisions in finished story chapters. Absent = not yet played."
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "ProgressReport": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version"
          },
          "student_id": {
            "type": "string",
            "pattern": "^STU-[0-9A-Z]{4}-[0-9A-Z]{4}$",
            "title": "Student Id"
          },
          "revision": {
            "type": "integer",
            "maximum": 1000000000.0,
            "minimum": 1.0,
            "title": "Revision"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "last_activity_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Activity At"
          },
          "app_version": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^[0-9A-Za-z.+-]*$",
            "title": "App Version",
            "default": ""
          },
          "story": {
            "$ref": "#/components/schemas/StoryPosition"
          },
          "chapters": {
            "items": {
              "$ref": "#/components/schemas/ChapterProgress"
            },
            "type": "array",
            "maxItems": 7,
            "title": "Chapters"
          },
          "badges": {
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,40}$"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Badges"
          },
          "indicators": {
            "$ref": "#/components/schemas/Indicators",
            "default": {}
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "student_id",
          "revision",
          "generated_at",
          "story",
          "chapters",
          "badges"
        ],
        "title": "ProgressReport"
      },
      "Registration": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 40,
            "minLength": 3,
            "title": "Code"
          },
          "registration_key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 22,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Registration Key"
          },
          "app_version": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^[0-9A-Za-z.+-]*$",
            "title": "App Version",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "registration_key"
        ],
        "title": "Registration"
      },
      "StoryPosition": {
        "properties": {
          "current_chapter": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Current Chapter"
          },
          "finished": {
            "type": "boolean",
            "title": "Finished"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "current_chapter",
          "finished"
        ],
        "title": "StoryPosition"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
